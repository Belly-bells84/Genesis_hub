FROM php:8.2-apache

# ============================================================
# Extensions PHP nécessaires
#   - gd        : requise par config/upload.php (ré-encodage des images)
#   - pdo_mysql : requise par toute l'application (obtenir_connexion())
#   - mbstring  : requise par mb_strlen() utilisé partout dans les traiter_*.php
# ============================================================
RUN apt-get update && apt-get install -y \
        libpng-dev \
        libjpeg62-turbo-dev \
        libwebp-dev \
        libzip-dev \
        unzip \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" gd pdo_mysql mbstring \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ============================================================
# Active mod_rewrite (nécessaire pour le .htaccess racine : routing
# vers index.php?url=$1) et mod_headers (utile pour la sécurité, voir
# apache-config/000-default.conf)
# ============================================================
RUN a2enmod rewrite headers

# ============================================================
# Autorise les .htaccess à s'appliquer partout dans le site.
# Sans ça, AUCUN .htaccess n'a d'effet par défaut sur l'image
# officielle php:apache (AllowOverride None) — ni celui de la racine
# (routing), ni celui d'asset/IMG/uploads/ (blocage d'exécution PHP).
# ============================================================
COPY docker/apache-config/000-default.conf /etc/apache2/sites-available/000-default.conf

# ============================================================
# Configuration PHP adaptée à l'upload de photos (5 Mo max côté appli,
# on laisse une marge côté PHP pour ne pas bloquer avant même le
# contrôle applicatif dans upload.php)
# ============================================================
COPY docker/php-config/uploads.ini /usr/local/etc/php/conf.d/uploads.ini

WORKDIR /var/www/html

# Le code applicatif est monté en volume en développement (voir
# docker-compose.yml) ; en production, décommentez la ligne suivante
# pour copier le code dans l'image plutôt que de le monter :
# COPY . /var/www/html

# Le dossier d'upload doit être écrit par le serveur web (www-data),
# et lisible par Apache pour resservir les images ensuite.
RUN mkdir -p /var/www/html/asset/IMG/uploads \
    && chown -R www-data:www-data /var/www/html/asset/IMG/uploads