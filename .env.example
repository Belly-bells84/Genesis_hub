# Copiez ce fichier en ".env" (sans ".example") et remplissez de vraies valeurs.
# Le fichier ".env" lui-même ne doit JAMAIS être commité dans Git
# (ajoutez-le à .gitignore), tout comme .env.dev et .env.prod.
#
# Ce fichier a un DOUBLE rôle ici, ne le videz pas de son contenu :
#   1. Docker Compose le lit automatiquement pour remplir les ${DB_NAME},
#      ${DB_USER}, ${DB_PASS}, ${DB_ROOT_PASSWORD} dans docker-compose.yml
#      (config du conteneur MySQL lui-même).
#   2. Votre config/env_loader.php le lit aussi, mais seulement pour lire
#      APP_ENV et savoir s'il doit charger .env.dev ou .env.prod ensuite.
#
# Les valeurs DB_NAME / DB_USER / DB_PASS ci-dessous DOIVENT être
# identiques à celles que vous mettrez dans .env.dev (voir ce fichier),
# puisque les deux décrivent la même base MySQL du conteneur "db".

APP_ENV=dev

DB_NAME=genesis
DB_USER=genesis_user
DB_PASS=changez_ce_mot_de_passe
DB_ROOT_PASSWORD=changez_aussi_celui_ci