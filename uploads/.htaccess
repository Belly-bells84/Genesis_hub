<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|php\d?|phtml|pht|phar|cgi|pl|py|sh)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|php\d?|phtml|pht|phar|cgi|pl|py|sh)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>