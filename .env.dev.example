# Copiez ce fichier en ".env.dev" (sans ".example") à la racine du projet.
# Lu directement par config/env_loader.php quand APP_ENV=dev.
# Ne JAMAIS commiter ce fichier dans Git.
#
# DB_HOST=db : "db" est le nom du service MySQL défini dans
# docker-compose.yml. En Docker, les conteneurs se joignent entre eux
# par le nom du service, jamais par "localhost" ni une IP fixe — Docker
# gère lui-même la résolution de "db" vers l'IP interne du conteneur
# MySQL sur le réseau du projet.
#
# DB_NAME / DB_USER / DB_PASS doivent être IDENTIQUES aux valeurs mises
# dans le ".env" racine (qui configure le conteneur MySQL côté Compose) :
# c'est la même base, décrite à deux endroits différents par contrainte
# du système à deux fichiers de env_loader.php.

DB_HOST=db
DB_NAME=genesis
DB_USER=genesis_user
DB_PASS=changez_ce_mot_de_passe